FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    SHEETSAGE2_MODEL_ROOT=/models
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-api.txt requirements-worker.txt ./
RUN pip install --no-cache-dir --default-timeout=180 --retries=5 \
      torch==2.8.0 torchaudio==2.8.0 \
      --index-url https://download.pytorch.org/whl/cu128 \
    && grep -vE '^(torch|torchaudio)==' requirements-worker.txt > /tmp/worker-no-torch.txt \
    && pip install --no-cache-dir --default-timeout=120 --retries=5 \
      -r /tmp/worker-no-torch.txt -r requirements-api.txt
COPY sheetsage2_service ./sheetsage2_service
RUN groupadd --gid 10001 sheetsage \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin sheetsage
USER 10001:10001
CMD ["python", "-m", "sheetsage2_service.worker"]
