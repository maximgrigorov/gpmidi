# Pinned versions for AILab k3s bootstrap
# All components are version-locked for reproducibility.

K3S_VERSION="v1.36.2+k3s1"
NVIDIA_DEVICE_PLUGIN_VERSION="v0.19.3"
CUDA_IMAGE="nvidia/cuda:13.1.0-base-ubuntu24.04"
PYTORCH_IMAGE="pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime"
PYTHON_IMAGE="python:3.12-slim"
TEKTON_PIPELINES_VERSION="v1.14.1"

# Cluster dashboard. Helm client is installed by scripts/install-helm.sh; the
# Headlamp chart comes from the official kubernetes-sigs repository
# (https://kubernetes-sigs.github.io/headlamp/) and is always passed to
# `helm upgrade --install` with --version. HEADLAMP_APP_VERSION is the chart's
# declared appVersion at HEADLAMP_CHART_VERSION, recorded for traceability.
HELM_VERSION="v3.21.3"
HEADLAMP_CHART_VERSION="0.44.0"
HEADLAMP_APP_VERSION="0.44.0"
# sha256 of headlamp-0.44.0.tgz as published in the repository index; verify with
#   helm pull headlamp/headlamp --version 0.44.0 -d /tmp && sha256sum /tmp/headlamp-0.44.0.tgz
HEADLAMP_CHART_SHA256="02ea3f0131cc8ec02d647dff53802eaf8f7e8d9428cf7b5c4648486352d57f85"

TEKTON_TRIGGERS_VERSION="v0.36.0"
KANIKO_VERSION="v1.23.2"

# CI gate toolchain, all pinned inside infra/ailab/tekton/Dockerfile.ci
KUBECTL_VERSION="v1.32.4"
KUBECONFORM_VERSION="v0.7.0"
SHELLCHECK_VERSION="v0.11.0"
GITLEAKS_VERSION="8.24.3"
TRIVY_VERSION="0.72.0"
CRANE_VERSION="v0.20.3"
RUFF_VERSION="0.15.6"
GITEA_VERSION="1.25.5"
