# Local gpmidi-web development defaults. Copy to .env; never commit .env.
SECRET_KEY=dev-only-change-me
GPMIDI_DATA_ROOT=./data
ASSET_API_BASE=http://127.0.0.1:8001/asset-api
REFERENCE_TIME_BASE=http://127.0.0.1:8002/reference-time
ASSET_API_VERIFY_TLS=false
ASSET_API_TIMEOUT=30
CUPS_SERVER=192.168.20.64
CUPS_PRINTER=

# Optional paid provider integration. Leave blank unless explicitly authorized.
OPENAI_TOKEN=
OPENAI_ARRANGEMENT_MODEL=gpt-5.6-sol
OPENAI_ARRANGEMENT_TIMEOUT_SECONDS=180
OPENAI_ARRANGEMENT_MAX_OUTPUT_TOKENS=5000
OPENAI_ARRANGEMENT_MAX_ESTIMATED_USD=0.50
